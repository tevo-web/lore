{
  "name": "lore-desktop",
  "version": "0.2.6",
  "private": true,
  "description": "Lore: the private, AI-assisted browser that remembers you, and only you",
  "license": "MIT",
  "author": "Tevo",
  "homepage": "https://tevo-web.github.io/lore/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tevo-web/lore.git",
    "directory": "desktop"
  },
  "bugs": {
    "url": "https://github.com/tevo-web/lore/issues"
  },
  "keywords": [
    "browser",
    "privacy",
    "ai",
    "electron",
    "vietnamese"
  ],
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "electron test-e2e/run.js && electron test-e2e/pages.js && electron test-e2e/privacy.js && electron test-e2e/extract.js && electron test-e2e/shield.js && electron test-e2e/browser.js && electron test-e2e/offline.js && electron test-e2e/import.js && electron test-e2e/features.js",
    "demo-portal": "node fixtures/portal.js",
    "filters": "node scripts/build-filters.js",
    "dist:win": "electron-builder --win nsis --x64 -c.win.signAndEditExecutable=false --publish never",
    "dist:win:signed": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64 -c.mac.identity=null --publish never",
    "dist:mac:signed": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64 --publish never",
    "predist:win": "npm run filters",
    "predist:win:signed": "npm run filters",
    "predist:mac": "npm run filters",
    "predist:mac:signed": "npm run filters",
    "predist:linux": "npm run filters",
    "check:electron": "node scripts/check-electron.js",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^25.1.8"
  },
  "productName": "Lore",
  "build": {
    "appId": "app.tevo.lore",
    "productName": "Lore",
    "copyright": "Tevo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lore-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Lore"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Lore-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;WebBrowser",
      "synopsis": "The private AI browser",
      "artifactName": "Lore-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Lore-linux-x64.AppImage"
    },
    "protocols": [
      {
        "name": "Web site",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "tevo-web",
        "repo": "lore"
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.11",
    "pdfjs-dist": "^6.4.299"
  },
  "engines": {
    "node": ">=22"
  }
}
